# Firebase Configuration for Expo
# Copy this file to .env.local and fill in your values from Firebase Console
# https://console.firebase.google.com/project/skysense-5084d/settings/general/

# Required - Firebase Config (EXPO_PUBLIC_ prefix for Expo)
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=skysense-5084d.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=skysense-5084d
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=skysense-5084d.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# Optional - Firebase Analytics (not implemented yet)
# EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional - Firebase Emulator (development only)
# EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false