# Firebase Web SDK Configuration
# Copy this file to .env.local and fill in your values from Firebase Console
# https://console.firebase.google.com/project/skysense-5084d/settings/general/

# ---------------------------------------------------------------------------
# OPENWEATHER (WEATHER EXPERIENCE) — OPTIONAL SERVER-SIDE KEY
# ---------------------------------------------------------------------------
# Enables live city weather + location search on the Weather page (current
# weather, 5-day/3-hour forecast, geocoding). Keep it SERVER-SIDE ONLY (no
# NEXT_PUBLIC_ prefix) — it is read in /api/weather/* route handlers and never
# bundled to the browser.
#
# When unset, the Weather page gracefully falls back to the deterministic
# simulated demo provider and labels data as simulated. Never commit a real
# key; get one at https://openweathermap.org/api and put it in .env.local
# (already git-ignored) or the host environment.
# OPENWEATHER_API_KEY=

# Required - Firebase Web App Config
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=skysense-5084d.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=skysense-5084d
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=skysense-5084d.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Optional - Firebase Analytics (not implemented yet)
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional - Firebase Emulator (development only)
# Set to "true" to connect to local Firebase emulators
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# ---------------------------------------------------------------------------
# FUTURE ESP32 DEVICE CREDENTIAL (SERVER-SIDE ONLY)
# ---------------------------------------------------------------------------
# The physical ESP32 station does NOT exist yet, so no device secret is
# provisioned and device authentication is NOT enforced. When the hardware is
# built, generate a strong random secret, set this variable on the server, and
# program the same value into the ESP32 firmware. The firmware sends it in the
# request header `x-skysense-device-token`; the ingestion API then rejects
# requests without a matching token (see src/lib/devices/deviceAuth.ts).
#
# NEVER commit a real value. This file ships the placeholder only; a real
# secret must be supplied via the server environment, not source control.
# SKYSENSE_ESP32_DEVICE_SECRET=

# ---------------------------------------------------------------------------
# FUTURE DEVICE HEARTBEAT THRESHOLDS (SERVER-SIDE ONLY)
# ---------------------------------------------------------------------------
# Connection state is derived from how recently the device reported telemetry
# (see src/lib/devices/heartbeat.ts). These thresholds are configurable; when
# unset, defaults are used (5 min = STALE, 15 min = OFFLINE).
# A device is NEVER reported ONLINE unless real telemetry/heartbeat has been
# received. In Simulation Mode no heartbeat exists.
# SKYSENSE_DEVICE_STALE_AFTER_MS=300000
# SKYSENSE_DEVICE_OFFLINE_AFTER_MS=900000

# Raw device readings are persisted to the Firestore subcollection
# deviceReadings/{deviceId}/readings (same project as the Firebase web config
# above), reusing the existing @skysense/api database layer.

# ---------------------------------------------------------------------------
# SERVER-SIDE FIREBASE ADMIN CREDENTIAL (PERSISTENCE) — SERVER ONLY
# ---------------------------------------------------------------------------
# The device ingestion API persists readings through the Firebase Admin SDK
# (src/lib/devices/storage.ts -> packages/api/src/admin.ts) with a trusted
# service identity. These variables are SERVER-SIDE ONLY: they are NOT prefixed
# NEXT_PUBLIC_, so they are never bundled to the browser. Provide exactly ONE:
#
#   A) Full service-account key JSON as a single-line string:
#      FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}
#      (download from Firebase Console -> Project settings -> Service accounts)
#
#   B) Path to a downloaded service-account key file:
#      GOOGLE_APPLICATION_CREDENTIALS=/path/to/skysense-firebase-adminsdk-key.json
#
#   C) Component values (private key needs literal \n line breaks escaped):
#      FIREBASE_PROJECT_ID=skysense-5084d
#      FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@skysense-5084d.iam.gserviceaccount.com
#      FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Local development WITHOUT a key: run the Firestore emulator and set
#      FIRESTORE_EMULATOR_HOST=localhost:8080
# (the Admin SDK then talks to the emulator; no credential is required).
#
# NEVER commit a real key. Only placeholders live in this file. Keep real
# values in .env.local (already git-ignored) or the host's environment.
# FIREBASE_SERVICE_ACCOUNT=
# GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIRESTORE_EMULATOR_HOST=