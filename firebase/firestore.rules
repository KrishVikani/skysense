rules_version = '2';
// SKYSENSE Firestore security rules — device ingestion (ESP32, future).
//
// CURRENT STATE (hardware phase complete):
// - Device persistence runs SERVER-SIDE through the Firebase Admin SDK
//   (packages/api/src/admin.ts), which carries a trusted service identity and
//   BYPASSES these rules. The server is the enforcement point for the device
//   token (x-skysense-device-token), because rules cannot inspect headers.
// - Therefore `deviceReadings` stays DENY-BY-DEFAULT for every client. There
//   is NO public write access anywhere in these rules.
// - The browser web SDK (`@skysense/api`) is used only for user auth/profiles
//   and never touches `deviceReadings` — browser and server persistence are
//   kept separate.
//
// DEPLOYMENT: when activating real persistence, only the server environment
// needs the service-account credential (FIREBASE_SERVICE_ACCOUNT, etc.).
// These rules do NOT need to open `deviceReadings` for that to work.
//
// If you ever deploy the Firestore emulator locally, this file is used for
// client-SDK rule tests; it intentionally keeps device reads/writes denied.

service cloud.firestore {
  match /databases/{database}/documents {
    // User-scoped collections stay locked to authenticated users.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Device raw readings — server (Admin SDK) only. Deny all clients.
    match /deviceReadings/{deviceId}/readings/{readingId} {
      allow read, write: if false;
    }
  }
}